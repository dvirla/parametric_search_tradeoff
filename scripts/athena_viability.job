#!/bin/bash
#SBATCH --job-name=athena_viability
#SBATCH --account=reichart_prj
#SBATCH --partition=l40s-shared,a100-public,l40s-public
#SBATCH --qos=4d_1g
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=00:30:00
#SBATCH --output=/home/dvirla/parametric_search_tradeoff/results/athena_viability_%j.log

# Confirm the restored venv is production-ready for OTHER experiments:
#  1) plain `uv run` (as normal jobs use it) is a fast no-op that does NOT rebuild/wipe
#     the venv -- proven by running WITHOUT --no-sync and checking uv installs nothing;
#  2) the heavy deps other experiments rely on import + CUDA is visible;
#  3) ollama on the allocated GPU serves a model (the standard eval path).
# UV_CACHE_DIR points at the persistent mount so that IF any sync is ever triggered it
# won't fill the container tmpfs (the failure that wiped the venv earlier).
srun apptainer exec --nv \
     --bind /home/dvirla/parametric_search_tradeoff:/workspace \
     --bind /home/dvirla/work:/work \
     /home/dvirla/agents_container.sqsh \
     /bin/bash -c '
       export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
       export OLLAMA_MODELS=/work/ollama/models
       export UV_CACHE_DIR=/workspace/.uv_cache
       cd /workspace
       echo "=== 1) plain uv run: does it install anything or just audit? ==="
       # -v so uv prints whether it resolved/installed vs audited-no-changes.
       uv run -v python -c "print(\"uv run reached python\")" 2>&1 | grep -iE "Installed|Uninstalled|Building|Audited|Resolved|no changes|Prepared" | head -20
       echo "=== 2) heavy deps + CUDA ==="
       uv run --no-sync python -c "
import torch, transformers, pydantic_ai, datasets, numpy, scipy, logfire
print(\"torch\", torch.__version__, \"cuda_available\", torch.cuda.is_available(), torch.cuda.device_count(), \"x\", torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"none\")
print(\"transformers\", transformers.__version__)
print(\"HEAVY_IMPORTS_OK\")
" 2>&1 | tail -8
       echo "=== 3) ollama serves a model on the allocated GPU ==="
       OLLAMA_HOST=127.0.0.1:11434 ollama serve > /workspace/results/athena_viab_ollama_${SLURM_JOB_ID}.log 2>&1 &
       for i in $(seq 1 60); do curl -s 127.0.0.1:11434/api/version >/dev/null 2>&1 && break; sleep 2; done
       curl -s --max-time 120 http://127.0.0.1:11434/api/chat \
         -d "{\"model\":\"gpt-oss:20b\",\"messages\":[{\"role\":\"user\",\"content\":\"Say hi in one word.\"}],\"stream\":false}" \
         | head -c 200; echo
       echo "=== ATHENA_VIABILITY_DONE $(date -Is) ==="
     '
