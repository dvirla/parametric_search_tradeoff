#!/bin/bash
#SBATCH --job-name=medqa_confparam
#SBATCH --account=reichart_prj
#SBATCH --partition=l40s-shared,a100-public,l40s-public
#SBATCH --qos=12h_4g
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --output=/home/dvirla/parametric_search_tradeoff/results/athena_medqa_confparam_%j.log

# MedQA confident_parametric condition ("you already have the relevant knowledge, no need to
# search" instruction cue), full 500-question set, for ONE ollama model. orig_plain baseline
# already exists in results/medqa_grid for these models -- this job only adds the new condition,
# writing into the SAME per-model directory. Self-contained ollama on the allocated GPU.
# Regex-graded only (NO_GRADER=1), matching the locked convention for these cue evals.
# Footprint (qos=12h_4g, 8cpu/32G, 6h) matches the leaner setup converged on for sharded
# per-condition cue evals (see commit history on the now-retired athena_frames_cue_eval.job).
#   MODEL       ollama model tag, e.g. gemma4:31b, qwen3.5:122b, gpt-oss:120b
#   CONDITION   orig_confident_parametric (default)
#   OLLAMA_VER  empty (default) = container's built-in ollama. Set to a tree under /work/opt/ollama
#               (e.g. 0.32.5) for models the old binary can't serve -- gemma4:31b/e4b REQUIRE it.
#   OLLAMA_PARALLEL / NUM_WORKERS  default 6/6. Lower both together for very large models (e.g.
#               122B-class) whose ollama runner gets OOM-killed under 6-way concurrency even with
#               bumped --mem -- e.g. OLLAMA_PARALLEL=2 NUM_WORKERS=2.
MODEL="${MODEL:-gemma4:31b}"
CONDITION="${CONDITION:-orig_confident_parametric}"
OLLAMA_VER="${OLLAMA_VER:-}"
OLLAMA_PARALLEL="${OLLAMA_PARALLEL:-6}"
NUM_WORKERS="${NUM_WORKERS:-6}"

srun apptainer exec --nv \
     --bind /home/dvirla/parametric_search_tradeoff:/workspace \
     --bind /home/dvirla/work:/work \
     /home/dvirla/agents_container.sqsh \
     /bin/bash -c "
       export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
       [ -n '${OLLAMA_VER}' ] && export PATH=/work/opt/ollama/${OLLAMA_VER}/bin:\$PATH
       echo '=== ollama binary:' \$(command -v ollama) \$(ollama --version 2>&1 | tail -1) '==='
       export OLLAMA_MODELS=/work/ollama/models
       export UV_CACHE_DIR=/workspace/.uv_cache
       cd /workspace
       PORT=\$((11500 + SLURM_JOB_ID % 4000))
       export OLLAMA_HOST=127.0.0.1:\$PORT
       export OLLAMA_BASE_URL=http://127.0.0.1:\$PORT/v1
       OLLAMA_NUM_PARALLEL=$OLLAMA_PARALLEL ollama serve > /workspace/results/athena_medqa_confparam_ollama_\${SLURM_JOB_ID}.log 2>&1 &
       for i in \$(seq 1 90); do curl -s 127.0.0.1:\$PORT/api/version >/dev/null 2>&1 && break; sleep 2; done
       echo \"ollama on port \$PORT\"
       echo '=== ensuring model is pulled ==='; ollama pull '$MODEL'
       echo '=== models ==='; ollama list
       CONDITIONS='$CONDITION' \
       INDEX_DIR=data/medqa_index LOCAL_BACKEND=bm25 \
       RESULTS_ROOT=results/medqa_grid NO_GRADER=1 NUM_WORKERS=$NUM_WORKERS PARALLEL=0 \
         bash scripts/run_medqa_grid_experiment.sh '$MODEL'
       echo \"=== MEDQA_${CONDITION}_DONE model=$MODEL \$(date -Is) ===\"
     "
