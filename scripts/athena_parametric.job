#!/bin/bash
# Athena SLURM job: run the PARAMETRIC PROBE (FRAMES + MedQA, plain original, no search, 3x) for
# ONE model inside the agents container. Clone of scripts/athena_qwen122b.job -- see
# docs/athena_container_eval.md for the full recipe + gotchas. Submit one job PER 120B-class model:
#   for M in qwen3.5:122b gpt-oss:120b nemotron-3-super; do
#     sbatch --export=ALL,MODEL="$M" scripts/athena_parametric.job
#   done
# A 122B (~81GB GGUF) fits on ONE h200/rtx6k GPU; the 120B-class models do NOT co-reside, hence one
# single-GPU job each. No data/*_index rsync needed -- the no_search probe never searches.
#SBATCH --job-name=param_probe
#SBATCH --account=reichart_prj
#SBATCH --partition=h200-shared,rtx6k-shared
#SBATCH --qos=4d_1g
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=32
#SBATCH --mem=128G
#SBATCH --time=96:00:00
#SBATCH --output=/home/dvirla/parametric_search_tradeoff/results/athena_param_%j.log

# Model to probe (override at submit time: sbatch --export=ALL,MODEL=gpt-oss:120b ...).
MODEL="${MODEL:-qwen3.5:122b}"
# Concurrency. With --no_grader there is no grader-latency throttle, so a single-GPU heavy model
# (122B) saturates Ollama's queue at high worker counts and the CLIENT times out waiting -> use
# NUM_WORKERS=1 for 122B, 2 for ~30B. Both overridable at submit time via --export.
NUM_WORKERS="${NUM_WORKERS:-2}"
OLLAMA_NUM_PARALLEL="${OLLAMA_NUM_PARALLEL:-$NUM_WORKERS}"

# apptainer (NOT pyxis --container-image). Model store is host-side at ~/work/ollama -> /work/ollama;
# repo (code + data + .env) mounted at /workspace. PATH + OLLAMA_MODELS MUST be set inside the container.
srun apptainer exec --nv \
     --bind /home/dvirla/parametric_search_tradeoff:/workspace \
     --bind /home/dvirla/work:/work \
     /home/dvirla/agents_container.sqsh \
     /bin/bash -c "
       export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
       export OLLAMA_MODELS=/work/ollama/models
       cd /workspace
       OLLAMA_HOST=127.0.0.1:11434 OLLAMA_NUM_PARALLEL=${OLLAMA_NUM_PARALLEL} \
         ollama serve > /workspace/results/athena_ollama_\${SLURM_JOB_ID}.log 2>&1 &
       for i in \$(seq 1 90); do
         curl -s 127.0.0.1:11434/api/version >/dev/null 2>&1 && break; sleep 2; done
       echo '=== ollama' \$(curl -s 127.0.0.1:11434/api/version) '==='
       echo '=== models ==='; ollama list
       PARALLEL=0 NUM_WORKERS=${NUM_WORKERS} MAX_PASSES=${MAX_PASSES:-20} bash scripts/run_parametric_probe_experiment.sh '${MODEL}'
       echo \"=== ATHENA_PARAM_JOB_DONE (\$MODEL) \$(date -Is) ===\"
     "
