#!/bin/bash
#SBATCH --job-name=reregister2
#SBATCH --account=reichart_prj
#SBATCH --partition=l40s-shared,a100-public,rtx6k-shared
#SBATCH --qos=4d_1g
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=01:00:00
#SBATCH --output=/home/dvirla/parametric_search_tradeoff/results/athena_reregister_%j.log

# Re-register both Q4 models with clean names, the stock gpt-oss harmony TEMPLATE (tools), AND
# explicit stops for <|call|> and <|return|> -- our converted GGUF lacks the harmony EOG metadata
# so without these the model never stops (malformed tool calls / rambling answers). Verify each
# with a real tool-call request before we trust it for the eval.
srun apptainer exec --nv \
     --bind /home/dvirla/parametric_search_tradeoff:/workspace \
     --bind /home/dvirla/work:/work \
     /home/dvirla/agents_container.sqsh \
     /bin/bash -c '
       export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
       export OLLAMA_MODELS=/work/ollama/models
       cd /workspace
       OLLAMA_HOST=127.0.0.1:11434 ollama serve > /workspace/results/athena_reregister_ollama_${SLURM_JOB_ID}.log 2>&1 &
       for i in $(seq 1 90); do curl -s 127.0.0.1:11434/api/version >/dev/null 2>&1 && break; sleep 2; done
       ollama show --modelfile gpt-oss:20b > /workspace/base_gptoss.modelfile 2>/dev/null
       set -- "Q4_K_M q4km" "Q4_K_S q4ks"
       for pair in "$@"; do
         Q=${pair% *}; clean=${pair#* }
         NAME=gpt-oss-frames-robust-$clean
         GG=/workspace/models/gpt-oss-frames-robust-$Q.gguf
         echo "=== re-register $NAME (template + stops) ==="
         sed "s|^FROM .*|FROM $GG|" /workspace/base_gptoss.modelfile > /workspace/Modelfile.$clean
         printf "PARAMETER stop \"<|call|>\"\nPARAMETER stop \"<|return|>\"\n" >> /workspace/Modelfile.$clean
         ollama rm $NAME 2>/dev/null
         ollama create $NAME -f /workspace/Modelfile.$clean 2>&1 | tail -2
         echo "-- tool-call verify $NAME --"
         curl -s --max-time 180 http://127.0.0.1:11434/api/chat -d "{
           \"model\":\"$NAME\",
           \"messages\":[{\"role\":\"user\",\"content\":\"Who won the 2010 Olympic mens ice hockey gold? Use search.\"}],
           \"tools\":[{\"type\":\"function\",\"function\":{\"name\":\"search\",\"description\":\"Web search\",\"parameters\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"]}}}],
           \"stream\":false}" | python3 -c "import sys,json; d=json.load(sys.stdin); m=d.get(\"message\",{}); print(\"tool_calls:\", m.get(\"tool_calls\"), \"| done_reason:\", d.get(\"done_reason\"))" 2>&1 | head -c 400; echo
       done
       ollama list 2>&1 | grep -iE "NAME|frames-robust-q4"
       echo "=== REREGISTER2_DONE $(date -Is) ==="
     '
