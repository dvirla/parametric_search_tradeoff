#!/bin/bash
#SBATCH --job-name=frames_sft_setup
#SBATCH --account=reichart_prj
#SBATCH --partition=l40s-shared,a100-public,l40s-public
#SBATCH --qos=4d_1g
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=/home/dvirla/parametric_search_tradeoff/results/athena_frames_setup_%j.log

# Repair/complete the venv corrupted by an interrupted `uv sync` (missing httpx, certifi
# cacert.pem, etc.). The container binds only /workspace and /work, so the default
# ~/.cache/uv lands on the tiny writable-tmpfs and fills up -> point UV_CACHE_DIR at the
# persistent /workspace mount. Restores certifi (so logfire's HTTPS trace export works) and
# verifies the FULL collector import chain before we trust --no-sync collection runs.
srun apptainer exec --nv \
     --bind /home/dvirla/parametric_search_tradeoff:/workspace \
     --bind /home/dvirla/work:/work \
     /home/dvirla/agents_container.sqsh \
     /bin/bash -c '
       export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
       export UV_CACHE_DIR=/workspace/.uv_cache
       cd /workspace
       echo "=== BEFORE: httpx import ==="
       uv run --no-sync python -c "import httpx; print(\"httpx OK\")" 2>&1 | tail -3
       echo "=== full uv sync (persistent cache) ==="
       uv sync 2>&1 | tail -15
       echo "=== VERIFY collector import chain + certifi ==="
       uv run --no-sync python -c "
import os, certifi
print(\"certifi cacert exists:\", os.path.exists(certifi.where()), certifi.where())
import httpx, pydantic_ai, logfire
import scripts.create_frames_sft_data as m
print(\"conditions:\", list(m.CONDITIONS.keys()))
print(\"COLLECTOR_IMPORTS_OK\")
" 2>&1 | tail -20
       echo "=== FRAMES_SETUP_DONE $(date -Is) ==="
     '
