#!/bin/bash
#SBATCH --job-name=go20b_frames
#SBATCH --account=reichart_prj
#SBATCH --partition=h200-shared,rtx6k-shared,a100-public,l40s-public
#SBATCH --qos=4d_1g
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=24
#SBATCH --mem=110G
#SBATCH --time=96:00:00
#SBATCH --output=/home/dvirla/parametric_search_tradeoff/results/athena_go20b_frames_%j.log
srun apptainer exec --nv --bind /home/dvirla/parametric_search_tradeoff:/workspace --bind /home/dvirla/work:/work /home/dvirla/agents_container.sqsh /bin/bash -c '
  export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
  export OLLAMA_MODELS=/work/ollama/models OLLAMA_HOST=127.0.0.1:11437 OLLAMA_BASE_URL=http://127.0.0.1:11437/v1
  cd /workspace
  OLLAMA_NUM_PARALLEL=6 ollama serve > /workspace/results/athena_oll_go20b_frames_${SLURM_JOB_ID}.log 2>&1 &
  for i in $(seq 1 90); do curl -s 127.0.0.1:11437/api/version >/dev/null 2>&1 && break; sleep 2; done
  echo "ollama :11437 $(curl -s 127.0.0.1:11437/api/version)"; ollama list
  SCALE=full PARALLEL=0 NUM_WORKERS=6 bash scripts/run_frames_grid_experiment.sh gpt-oss:20b
  echo "=== GO20b_frames_DONE $(date -Is) ==="
'
