#!/bin/bash
#SBATCH --job-name=gemmadiag
#SBATCH --account=reichart_prj
#SBATCH --partition=l40s-shared,a100-public,l40s-public,h200-shared,rtx6k-shared
#SBATCH --qos=4d_1g
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=01:00:00
#SBATCH --output=/home/dvirla/parametric_search_tradeoff/results/athena_gemmadiag_%j.log

# Diagnose the gemma-4 SFT `<channel|>` truncation. See scripts/diagnose_gemma_sft_channel.py.
srun apptainer exec --nv \
     --bind /home/dvirla/parametric_search_tradeoff:/workspace \
     --bind /home/dvirla/work:/work \
     /home/dvirla/agents_container.sqsh \
     /bin/bash -c "
       export PATH=/work/opt/ollama/0.32.5/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
       export OLLAMA_MODELS=/work/ollama/models
       cd /workspace
       PORT=\$((11500 + SLURM_JOB_ID % 4000))
       export OLLAMA_HOST=127.0.0.1:\$PORT
       OLLAMA_CONTEXT_LENGTH=32768 ollama serve > /workspace/results/athena_gemmadiag_ollama_\${SLURM_JOB_ID}.log 2>&1 &
       for i in \$(seq 1 90); do curl -s 127.0.0.1:\$PORT/api/version >/dev/null 2>&1 && break; sleep 2; done
       echo \"ollama \$(ollama --version 2>&1 | tail -1) on \$PORT\"
       N_PROBE=\${N_PROBE:-20} python3 scripts/diagnose_gemma_sft_channel.py
       echo '=== GEMMADIAG_DONE ==='
     "
