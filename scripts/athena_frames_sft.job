#!/bin/bash
#SBATCH --job-name=frames_sft_gptoss
#SBATCH --account=reichart_prj
#SBATCH --partition=l40s-shared,a100-public,l40s-public
#SBATCH --qos=4d_1g
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=96:00:00
#SBATCH --output=/home/dvirla/parametric_search_tradeoff/results/athena_frames_sft_%j.log

# FRAMES cue-robustness SFT rollout collection for gpt-oss:20b.
# Self-contained ollama on the allocated GPU (no nlp-srv3 contention). gpt-oss:20b
# (~16GB) fits easily on l40s (48GB) / a100 (80GB). Resumable via --resume.
#
# Overridable via env at submit time (sbatch --export):
#   MODEL   (default gpt-oss:20b)
#   LIMIT   (default empty = full 501; set e.g. 15 for a smoke run)
#   OUTDIR  (default data/sft/frames)
#   KROLL   (default 5)   NWORK (default 6)
#   OLLAMA_VER  empty (default) = the container's built-in ollama 0.18.2.
#               Set to a tree under /work/opt/ollama (e.g. 0.32.5) to use a newer ollama.
#               REQUIRED for gemma4:31b -- see athena_gemma4_tools_smoke.job.
#   NO_LOGFIRE  set to 1 to disable logfire tracing for this run (default: enabled).
#   CONDITIONS  empty (default) = the collector's own default (all conditions in ALL_CONDITIONS).
#               Set to a space-separated subset (e.g. "verbose_multiturn verbose_searchmulti")
#               for an explicit/partial launch, e.g. a smoke test of just the new conditions.
MODEL="${MODEL:-gpt-oss:20b}"
LIMIT="${LIMIT:-}"
OUTDIR="${OUTDIR:-data/sft/frames}"
KROLL="${KROLL:-5}"
NWORK="${NWORK:-6}"
OLLAMA_VER="${OLLAMA_VER:-}"
NO_LOGFIRE="${NO_LOGFIRE:-}"
CONDITIONS="${CONDITIONS:-}"

srun apptainer exec --nv \
     --bind /home/dvirla/parametric_search_tradeoff:/workspace \
     --bind /home/dvirla/work:/work \
     --bind /rg/reichart_prj/dvirla:/rg/reichart_prj/dvirla \
     /home/dvirla/agents_container.sqsh \
     /bin/bash -c "
       export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
       [ -n '${OLLAMA_VER}' ] && export PATH=/work/opt/ollama/${OLLAMA_VER}/bin:\$PATH
       echo '=== ollama binary:' \$(command -v ollama) \$(ollama --version 2>&1 | tail -1) '==='
       export OLLAMA_MODELS=/work/ollama/models
       # Logfire tracing is ENABLED (traces -> logfire-us.pydantic.dev/dl8495/searcheval).
       # It previously wedged the workers only because the venv had been wiped and
       # certifi/cacert.pem was missing, so the OTLP exporter raised on every HTTPS post.
       # With the venv restored (certifi verified present) the export succeeds normally.
       # UV_CACHE_DIR must point at the persistent mount: uv's default cache lands on the
       # small writable-tmpfs, and a sync that fills it is what wiped the venv before.
       export UV_CACHE_DIR=/workspace/.uv_cache
       # Opt-in logfire disable (load_dotenv uses override=False, so an exported empty key wins).
       [ -n '${NO_LOGFIRE}' ] && { export LOGFIRE_API_KEY=''; echo '=== logfire DISABLED for this run ==='; }
       cd /workspace
       OLLAMA_HOST=127.0.0.1:11434 OLLAMA_NUM_PARALLEL=${NWORK} \
         ollama serve > /workspace/results/athena_ollama_\${SLURM_JOB_ID}.log 2>&1 &
       for i in \$(seq 1 90); do
         curl -s 127.0.0.1:11434/api/version >/dev/null 2>&1 && break; sleep 2; done
       echo '=== ollama' \$(curl -s 127.0.0.1:11434/api/version) '==='
       echo '=== models ==='; ollama list
       # Warm-load the model once and fail loudly if the runner cannot start.
       echo '=== warmup ==='
       curl -s --max-time 180 http://127.0.0.1:11434/api/chat \
         -d '{\"model\":\"${MODEL}\",\"messages\":[{\"role\":\"user\",\"content\":\"Say hi in one word.\"}],\"stream\":false}' \
         | head -c 300; echo
       LIMIT_ARG=''; [ -n '${LIMIT}' ] && LIMIT_ARG='--limit ${LIMIT}'
       CONDITIONS_ARG=''; [ -n '${CONDITIONS}' ] && CONDITIONS_ARG='--conditions ${CONDITIONS}'
       echo \"=== collecting: model=${MODEL} limit='${LIMIT}' out=${OUTDIR} k=${KROLL} workers=${NWORK} conditions='${CONDITIONS}' ===\"
       uv run --no-sync python scripts/create_frames_sft_data.py \
         --model '${MODEL}' --provider ollama \
         --k ${KROLL} --num-workers ${NWORK} \
         --dataset-path data/frames_cues/neutral_audited.jsonl \
         --index-dir data/frames_index --local-backend bm25 \
         --output-dir ${OUTDIR} \$LIMIT_ARG \$CONDITIONS_ARG --resume
       echo \"=== FRAMES_SFT_JOB_DONE \$(date -Is) ===\"
     "
