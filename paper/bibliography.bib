	file = {Preprint PDF:/home/dvirla/Zotero/storage/YZ5WICTP/Li and Flanigan - 2024 - RAC Efficient LLM Factuality Correction with Retrieval Augmentation.pdf:application/pdf;Snapshot:/home/dvirla/Zotero/storage/Z4PNEWIS/2410.html:text/html},
